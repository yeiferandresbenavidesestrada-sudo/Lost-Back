                createdAt: new Date(Date.now() - 3600000 * 5).toISOString()
            },
            {
                id: 'sample-2',
                title: 'Calculadora Científica Casio FX-82',
                category: 'Electrónica',
status: 'FOUND',
                location: 'Biblioteca - Mesa 4',
                description: 'Color negro, tiene un sticker de astronauta en la tapa trasera.',
                handover: 'Entregado a la Bibliotecaria Profesora María Gómez',
                contact: 'María Gómez (Bibliotecaria)',
                reporterName: 'Carlos Ruiz',
                pin: '9999',
                photoUrl: 'https://images.unsplash.com/photo-1611125832047-1d7ad1e8e48a?auto=format&fit=crop&w=600&q=80',
                createdAt: new Date(Date.now() - 3600000 * 24).toISOString()
            },
            {
                id: 'sample-3',
                title: 'Termo Metálico Azul Totto',
                category: 'Termos o loncheras',
                status: 'FOUND',
                location: 'Cafetería Central',
                description: 'Termo metálico azul rey con tapa roscable plateada, ligero rayón abajo.',
                handover: 'Dejado en la caja de la Cafetería con Don José',
                contact: 'Don José - Cafetería',
                reporterName: 'Ana Lucía',
                pin: '0000',
                photoUrl: 'https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=600&q=80',
                createdAt: new Date(Date.now() - 3600000 * 48).toISOString()
            }
        ];

        // Global items storage in memory
        window.allReportedItems = [];

        // Initialize Firebase
        async function initBackend() {
            if (firebaseConfig) {
                try {
                    const app = initializeApp(firebaseConfig);
                    db = getFirestore(app);
                    auth = getAuth(app);

                    // Auth Setup
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    onAuthStateChanged(auth, (user) => {
                        if (user) {
                            currentUserId = user.uid;
                            isFirebaseActive = true;
                            subscribeToFirestore();
                        } else {
                            loadLocalFallback();
                        }
                    });

                } catch (e) {
                    console.warn("Firestore setup warning, fallback active:", e);
                    loadLocalFallback();
                }
            } else {
                loadLocalFallback();
            }
        }

        // Firestore Realtime Subscription (Rule 1 & Rule 2 compliant path)
        function subscribeToFirestore() {
            if (!db || !isFirebaseActive) return;

            const itemsRef = collection(db, 'artifacts', appId, 'public', 'data', 'lost_found_items');
            
            onSnapshot(itemsRef, (snapshot) => {
                const cloudItems = [];
                snapshot.forEach(docSnap => {
                    cloudItems.push({ id: docSnap.id, ...docSnap.data() });
                });

                if (cloudItems.length === 0) {
                    // Seed initial items if collection empty
                    seedInitialData();
                } else {
                    window.allReportedItems = cloudItems;
                    saveToLocalStorage(cloudItems);
                    window.applyFilters();
                }
            }, (error) => {
                console.error("Firestore listener error:", error);
                loadLocalFallback();
            });
        }

        async function seedInitialData() {
            if (!db || !isFirebaseActive) return;
            for (const item of SAMPLE_ITEMS) {
                const itemRef = doc(db, 'artifacts', appId, 'public', 'data', 'lost_found_items', item.id);
                await setDoc(itemRef, item);
            }
        }

        function loadLocalFallback() {
            const stored = localStorage.getItem(LOCAL_STORAGE_KEY);
            if (stored) {
                try {
                    window.allReportedItems = JSON.parse(stored);
                } catch(e) {
                    window.allReportedItems = SAMPLE_ITEMS;
                }
            } else {
                window.allReportedItems = SAMPLE_ITEMS;
                saveToLocalStorage(SAMPLE_ITEMS);
            }
            window.applyFilters();
        }

        function saveToLocalStorage(items) {
            try {
                localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(items));
            } catch(e){}
        }

        // Save new item globally
        window.saveItemToNube = async function(newItem) {
            if (isFirebaseActive && db) {
                try {
                    const itemRef = doc(db, 'artifacts', appId, 'public', 'data', 'lost_found_items', newItem.id);
                    await setDoc(itemRef, newItem);
                } catch(e) {
                    console.error("Error saving to cloud:", e);
                }
            }
            // Always update local storage array
            window.allReportedItems.unshift(newItem);
            saveToLocalStorage(window.allReportedItems);
            window.applyFilters();
        };

        // Remove item globally
        window.removeItemFromNube = async function(itemId) {
            if (isFirebaseActive && db) {
                try {
                    const itemRef = doc(db, 'artifacts', appId, 'public', 'data', 'lost_found_items', itemId);
                    await deleteDoc(itemRef);
                } catch(e) {
                    console.error("Error deleting from cloud:", e);
                }
            }
            window.allReportedItems = window.allReportedItems.filter(i => i.id !== itemId);
            saveToLocalStorage(window.allReportedItems);
            window.applyFilters();
        };

        // Kickoff Backend
        initBackend();
    </script>

    <!-- MAIN APP JAVASCRIPT LOGIC -->
    <script>
        let currentUserName = localStorage.getItem('lost_back_user_name') || '';
        let base64PhotoData = null;

        // Initialize state on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            // Check if user name stored
            if (currentUserName) {
                document.getElementById('user-full-name').value = currentUserName;
                setLoggedInUser(currentUserName);
                document.getElementById('welcome-screen').classList.add('hidden');
            }

            // Connectivity Listeners
            window.addEventListener('online', () => updateOnlineStatus(true));
            window.addEventListener('offline', () => updateOnlineStatus(false));
            checkConnectivity(false);

            // Drag and drop setup
            setupDragAndDrop();
        });

        // Connectivity Handler
        function checkConnectivity(manualClick = false) {
            const isOnline = navigator.onLine;
            updateOnlineStatus(isOnline);
            if (manualClick && isOnline) {
                const toast = document.getElementById('online-toast');
                toast.classList.remove('translate-y-[-150%]');
                setTimeout(() => toast.classList.add('translate-y-[-150%]'), 3000);
            }
        }

        function updateOnlineStatus(isOnline) {
            const offlineScreen = document.getElementById('offline-screen');
            const toast = document.getElementById('online-toast');

            if (!isOnline) {
                offlineScreen.classList.remove('hidden');
                offlineScreen.classList.add('flex');
            } else {
                offlineScreen.classList.add('hidden');
                offlineScreen.classList.remove('flex');
            }
        }

        // Welcome Screen Form
        function submitWelcomeForm(event) {
            event.preventDefault();
            const nameInput = document.getElementById('user-full-name').value.trim();
            if (!nameInput) return;

            currentUserName = nameInput;
            localStorage.setItem('lost_back_user_name', currentUserName);
            setLoggedInUser(currentUserName);

            document.getElementById('welcome-screen').classList.add('hidden');
        }

        function setLoggedInUser(name) {
            document.getElementById('header-user-name').innerText = name;
            document.getElementById('user-avatar-initial').innerText = name.charAt(0).toUpperCase();
        }

        // Tab Switching Logic
        function switchTab(tabName) {
            const catalogSec = document.getElementById('section-catalog');
            const reportSec = document.getElementById('section-report');
            const navBtnCatalog = document.getElementById('nav-btn-catalog');
            const navBtnReport = document.getElementById('nav-btn-report');

            if (tabName === 'catalog') {
                catalogSec.classList.remove('hidden');
                reportSec.classList.add('hidden');

                navBtnCatalog.className = "py-3 px-2 border-b-2 border-school-yellow font-bold text-school-yellow flex items-center space-x-2 transition-colors";
                navBtnReport.className = "py-3 px-2 border-b-2 border-transparent text-slate-400 hover:text-white font-bold flex items-center space-x-2 transition-colors";
                window.scrollTo({ top: 0, behavior: 'smooth' });
