        // Filter & Search Engine
        window.applyFilters = function() {
            const searchTerm = (document.getElementById('search-input')?.value || '').toLowerCase();
            const selectedCat = document.getElementById('filter-category')?.value || 'ALL';
            const selectedStatus = document.getElementById('filter-status')?.value || 'ALL';

            const items = window.allReportedItems || [];

            const filtered = items.filter(item => {
                // Search query match
                const matchSearch = 
                    item.title.toLowerCase().includes(searchTerm) ||
                    item.description.toLowerCase().includes(searchTerm) ||
                    item.location.toLowerCase().includes(searchTerm) ||
                    item.category.toLowerCase().includes(searchTerm);

                // Category match
                let matchCat = true;
                if (selectedCat !== 'ALL') {
                    matchCat = item.category.startsWith(selectedCat);
                }

                // Status match
                let matchStatus = true;
                if (selectedStatus !== 'ALL') {
                    matchStatus = item.status === selectedStatus;
                }

                return matchSearch && matchCat && matchStatus;
            });

            renderCatalog(filtered);
        };

        function resetFilters() {
            if (document.getElementById('search-input')) document.getElementById('search-input').value = '';
            if (document.getElementById('filter-category')) document.getElementById('filter-category').value = 'ALL';
            if (document.getElementById('filter-status')) document.getElementById('filter-status').value = 'ALL';
            window.applyFilters();
        }

        // Render Cards to UI
        function renderCatalog(items) {
            const grid = document.getElementById('catalog-grid');
            const emptyState = document.getElementById('empty-state');
            const countEl = document.getElementById('items-count');

            if (!grid) return;

            countEl.innerText = items.length;

            if (items.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            grid.innerHTML = items.map(item => {
                const isLost = item.status === 'LOST';
                const statusBadge = isLost
                    ? `<span class="bg-red-500 text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-xs flex items-center space-x-1">
                        <i class="fa-solid fa-circle-exclamation text-[10px]"></i><span>Lo perdí</span>
                       </span>`
                    : `<span class="bg-emerald-600 text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-xs flex items-center space-x-1">
                        <i class="fa-solid fa-hand-holding-heart text-[10px]"></i><span>Lo encontré</span>
                       </span>`;

                const formattedDate = new Date(item.createdAt).toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                const handoverSection = item.handover ? `
                    <div class="mt-3 p-2.5 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-900 flex items-start space-x-2">
                        <i class="fa-solid fa-user-shield text-school-orange mt-0.5"></i>
                        <div>
                            <span class="font-bold block">Ubicación de entrega:</span>
                            <span>${escapeHtml(item.handover)}</span>
                        </div>
                    </div>
                ` : '';

                return `
                    <div class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
                        <!-- Image Container -->
                        <div class="relative h-48 sm:h-52 bg-slate-100 overflow-hidden">
                            <img src="${item.photoUrl}" alt="${escapeHtml(item.title)}" onerror="this.src='https://placehold.co/600x400/1E3A8A/FEF116?text=Objeto+Lost+Back'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            
                            <!-- Status Badge -->
                            <div class="absolute top-3 left-3">
                                ${statusBadge}
                            </div>

                            <!-- Category Pill -->
                            <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-xs text-white text-[10px] font-bold px-2.5 py-1 rounded-lg">
                                ${escapeHtml(item.category)}
                            </div>
                        </div>

                        <!-- Content Body -->
                        <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                            <div>
                                <h3 class="text-base font-extrabold text-slate-900 group-hover:text-school-orange transition-colors line-clamp-1 mb-1">
                                    ${escapeHtml(item.title)}
                                </h3>
                                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-3">
                                    ${escapeHtml(item.description)}
                                </p>

                                <div class="space-y-1.5 text-xs text-slate-600">
                                    <div class="flex items-center space-x-2">
                                        <i class="fa-solid fa-location-dot text-school-orange w-4 text-center"></i>
                                        <span class="font-medium truncate">${escapeHtml(item.location)}</span>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <i class="fa-solid fa-address-book text-slate-400 w-4 text-center"></i>
                                        <span class="truncate">Contacto: <strong>${escapeHtml(item.contact)}</strong></span>
                                    </div>
                                    <div class="flex items-center space-x-2 text-[11px] text-slate-400 pt-1">
                                        <i class="fa-regular fa-clock w-4 text-center"></i>
                                        <span>${formattedDate} · Por ${escapeHtml(item.reporterName || 'Usuario')}</span>
                                    </div>
                                </div>

                                ${handoverSection}
                            </div>

                            <!-- Card Footer Action -->
                            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">PIN requerido</span>
                                <button onclick="openResolveModal('${item.id}')" class="bg-slate-100 hover:bg-red-50 text-slate-700 hover:text-red-600 font-bold text-xs py-2 px-3.5 rounded-xl transition-all border border-slate-200 flex items-center space-x-1.5">
                                    <i class="fa-solid fa-trash-can text-slate-400 group-hover:text-red-500"></i>
                                    <span>Dar de baja</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Resolve / Delete Modal Logic
        function openResolveModal(itemId) {
            document.getElementById('resolve-item-id').value = itemId;
            document.getElementById('resolve-pin-input').value = '';
            document.getElementById('resolve-error-msg').classList.add('hidden');
            document.getElementById('resolve-modal').classList.remove('hidden');
            setTimeout(() => document.getElementById('resolve-pin-input').focus(), 100);
        }

        function closeResolveModal() {
            document.getElementById('resolve-modal').classList.add('hidden');
        }

        async function confirmResolveItem(event) {
            event.preventDefault();
            const itemId = document.getElementById('resolve-item-id').value;
            const inputPin = document.getElementById('resolve-pin-input').value.trim();

            const targetItem = (window.allReportedItems || []).find(i => i.id === itemId);

            if (!targetItem) {
                closeResolveModal();
                return;
            }

            if (targetItem.pin === inputPin) {
                if (window.removeItemFromNube) {
                    await window.removeItemFromNube(itemId);
                }
                closeResolveModal();
            } else {
                document.getElementById('resolve-error-msg').classList.remove('hidden');
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
