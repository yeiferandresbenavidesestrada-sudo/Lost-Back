        }

        // Form Status Theme Highlight
        function updateStatusTheme(statusVal) {
            // Optional UI visual tweak when status changes
        }

        // Photo Upload Handling & FileReader
        function setupDragAndDrop() {
            const dropZone = document.getElementById('photo-drop-zone');
            if (!dropZone) return;

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files[0]) {
                    processImageFile(files[0]);
                }
            });
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) {
                processImageFile(file);
            }
        }

        function processImageFile(file) {
            if (!file.type.startsWith('image/')) {
                alert('Por favor selecciona un archivo de imagen válido.');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                base64PhotoData = e.target.result;
                document.getElementById('image-preview').src = base64PhotoData;
                document.getElementById('upload-prompt').classList.add('hidden');
                document.getElementById('image-preview-container').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }

        function removeSelectedImage() {
            base64PhotoData = null;
            document.getElementById('report-photo-file').value = '';
            document.getElementById('image-preview').src = '';
            document.getElementById('upload-prompt').classList.remove('hidden');
            document.getElementById('image-preview-container').classList.add('hidden');
        }

        // Handle Form Submission
        async function handleFormSubmit(event) {
            event.preventDefault();

            if (!base64PhotoData) {
                alert('Por favor adjunta una foto obligatoria del objeto.');
                return;
            }

            const status = document.querySelector('input[name="itemStatus"]:checked')?.value;
            const title = document.getElementById('report-title').value.trim();
            let category = document.getElementById('report-category').value;
            if (category === 'Otros') {
                const otherCat = document.getElementById('report-category-other').value.trim();
                category = otherCat ? `Otros (${otherCat})` : 'Otros';
            }
            const location = document.getElementById('report-location').value.trim();
            const description = document.getElementById('report-description').value.trim();
            const handover = document.getElementById('report-handover').value.trim();
            const contact = document.getElementById('report-contact').value.trim();
            const pin = document.getElementById('report-pin').value.trim();

            if (pin.length !== 4 || isNaN(pin)) {
                alert('El código PIN debe ser exactamente de 4 dígitos numéricos.');
                return;
            }

            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> <span>Guardando...</span>';

            const newItem = {
                id: 'report-' + Date.now(),
                title,
                category,
                status,
                location,
                description,
                handover,
                contact,
                reporterName: currentUserName || 'Estudiante',
                pin,
                photoUrl: base64PhotoData,
                createdAt: new Date().toISOString()
            };

            if (window.saveItemToNube) {
                await window.saveItemToNube(newItem);
            }

            // Reset Form
            document.getElementById('report-form').reset();
            removeSelectedImage();
            toggleOtherCategoryField('');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Publicar Reporte</span>';

